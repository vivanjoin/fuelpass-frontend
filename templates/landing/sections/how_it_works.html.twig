<section id="how" class="section">
    <div class="section-wrap">
        <div class="section-heading-row reveal">
            <div class="section-heading">
                <p class="eyebrow">How it works</p>
                <h2>Three steps. About four minutes.</h2>
                <p class="lead">No queue, no paperwork. A single account ties every vehicle in your household to a verified weekly quota.</p>
            </div>
        </div>
        <div class="steps">
            {% set steps = [
                {
                    'num': '01',
                    'title': 'Register your vehicles',
                    'text': 'Verify your phone with OTP, then link each vehicle by registration number and confirm its category.',
                    'illu': 'reg'
                },
                {
                    'num': '02',
                    'title': 'Get your weekly quota',
                    'text': 'Quotas land in your wallet every Monday, sized to your vehicle class and renewed automatically.',
                    'illu': 'quota'
                },
                {
                    'num': '03',
                    'title': 'Fuel up with QR',
                    'text': 'Show your QR at any participating pump — the operator scans, dispenses and your balance updates live.',
                    'illu': 'qr'
                }
            ] %}
            {% for step in steps %}
                <article class="step-card reveal {{ loop.index == 3 ? 'is-active' }}" data-delay="{{ loop.index }}">
                    <span class="step-number">{{ step.num }}</span>
                    <div class="step-visual">
                        {% if step.illu == 'reg' %}
                            <div class="step-illu-reg">
                                <div class="reg-card">
                                    <div class="reg-header"></div>
                                    <div class="reg-line"></div>
                                    <div class="reg-flex">
                                        <div class="reg-id">CAR · 1234</div>
                                        <div class="reg-btn">VERIFY</div>
                                    </div>
                                </div>
                            </div>
                        {% elseif step.illu == 'quota' %}
                            <div class="step-illu-quota-wrap">
                                <div class="step-illu-quota">
                                    <div class="quota-inner">
                                        <strong>20.0</strong>
                                        <small>LITERS / WEEK</small>
                                    </div>
                                </div>
                                <div class="step-illu-bars">
                                    <span></span>
                                    <span></span>
                                    <span class="is-active"></span>
                                    <span></span>
                                </div>
                            </div>
                        {% elseif step.illu == 'qr' %}
                            <div class="step-illu-qr-wrap">
                                <span class="illu-dot"></span>
                                <div class="step-illu-qr">
                                    <div class="qr-box">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="6" height="6"/><rect x="15" y="3" width="6" height="6"/><rect x="3" y="15" width="6" height="6"/><path d="M15 15h2v2h-2zM19 15h2v2h-2zM15 19h2v2h-2zM19 19h2v2h-2z"/></svg>
                                    </div>
                                    <div class="qr-label">SCAN AT PUMP</div>
                                </div>
                                <span class="illu-dot"></span>
                            </div>
                        {% endif %}
                    </div>
                    <h3>{{ step.title }}</h3>
                    <p>{{ step.text }}</p>
                </article>
            {% endfor %}
        </div>
    </div>
</section>
