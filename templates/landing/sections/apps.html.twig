<section id="apps" class="section citizen-section">
    <div class="section-wrap citizen-grid">
        <div class="reveal">
            <p class="eyebrow">Citizen app</p>
            <h2>Carry your quota in your pocket.</h2>
            <p class="lead">Install the FuelPass app once and every household vehicle is one tap away from the next pump scan.</p>
            
            <div class="app-bullets compact-list">
                <article>
                    <span class="icon-blue" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 14 4-4"></path><path d="M3.34 19a10 10 0 1 1 17.32 0"></path></svg>
                    </span>
                    <div>
                        <h3>Real-time quota tracking</h3>
                        <p>See how many litres you have left, on every vehicle, refreshed instantly after every fill.</p>
                    </div>
                </article>
                <article>
                    <span class="icon-indigo" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 10.7 2 10.8 2 11v5c0 .6.4 1 1 1h2"></path><circle cx="7" cy="17" r="2"></circle><circle cx="17" cy="17" r="2"></circle></svg>
                    </span>
                    <div>
                        <h3>Every household vehicle</h3>
                        <p>Link up to 5 cars and motorcycles — each draws from its own weekly quota, all in one app.</p>
                    </div>
                </article>
                <article>
                    <span class="icon-slate" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="3"></rect><rect x="14" y="7" width="3" height="3"></rect><rect x="7" y="14" width="3" height="3"></rect><rect x="14" y="14" width="3" height="3"></rect></svg>
                    </span>
                    <div>
                        <h3>Pay with a QR scan</h3>
                        <p>No cards, no cash dance. Show your QR at any participating station and you are done in seconds.</p>
                    </div>
                </article>
                <article>
                    <span class="icon-rose" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </span>
                    <div>
                        <h3>OTP login · biometric unlock</h3>
                        <p>Phone-based authentication with Face ID / fingerprint. No passwords to lose or share.</p>
                    </div>
                </article>
            </div>

            <div class="store-row">
                <a href="#" class="store-badge store-badge-apple" aria-label="Download on the App Store">
                    <span aria-hidden="true">
                        <svg viewBox="0 0 26 32" fill="currentColor"><path d="M17.7 16.7c0-3.2 2.6-4.7 2.7-4.8-1.5-2.2-3.8-2.5-4.6-2.5-1.9-.2-3.8 1.1-4.8 1.1-1 0-2.5-1.1-4.1-1.1-2.1 0-4 1.2-5.1 3.1-2.2 3.8-.6 9.4 1.6 12.5 1 1.5 2.3 3.2 4 3.1 1.6-.1 2.2-1 4.1-1s2.5 1 4.2 1c1.7 0 2.8-1.5 3.9-3 1.2-1.7 1.7-3.4 1.7-3.5-.1 0-3.6-1.3-3.6-4.9Zm-3.1-9c.9-1.1 1.4-2.6 1.3-4.1-1.3.1-2.8.8-3.7 1.9-.8 1-1.5 2.5-1.3 4 1.4.1 2.8-.7 3.7-1.8Z"/></svg>
                    </span>
                    <small>Download on the</small>
                    <strong>App Store</strong>
                </a>
                <a href="#" class="store-badge store-badge-google" aria-label="Get it on Google Play">
                    <span aria-hidden="true">
                        <svg viewBox="0 0 26 30"><path d="M2 1.5C1.6 1.9 1.4 2.5 1.4 3.3v23.4c0 .8.2 1.4.6 1.8l.1.1L15 15.1v-.3L2 1.5Z" fill="#5bc9f4"/><path d="m19.2 19.4-4.2-4.3v-.3l4.2-4.3.1.1 5 2.8c1.4.8 1.4 2.1 0 2.9l-5 2.9-.1.2Z" fill="#fee000"/><path d="M19.3 19.3 14.9 15 2 28c.5.5 1.3.5 2.2.1l15.1-8.8Z" fill="#ea4335"/><path d="M19.3 10.7 4.2 2C3.3 1.5 2.5 1.5 2 2l13 13 4.3-4.3Z" fill="#34a853"/></svg>
                    </span>
                    <small>Get it on</small>
                    <strong>Google Play</strong>
                </a>
            </div>
            <div class="qr-install">
                <div class="qr-code-placeholder qr-scanner" aria-hidden="true">
                    <span class="scanner-corner"></span>
                    <span class="scanner-corner"></span>
                    <span class="scanner-corner"></span>
                    <span class="scanner-corner"></span>
                    <span class="scanner-line"></span>
                    <svg viewBox="0 0 48 48" fill="none">
                        <path d="M5 5h14v14H5zM29 5h14v14H29zM5 29h14v14H5z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
                        <path d="M10 10h4v4h-4zM34 10h4v4h-4zM10 34h4v4h-4zM24 24h5v5h-5zM32 24h3v3h-3zM38 24h5v5h-5zM24 33h3v10h-3zM31 31h6v4h-6zM40 34h3v9h-3zM31 39h5v4h-5z" fill="currentColor"/>
                    </svg>
                </div>
                <div><strong>Scan to install</strong><p>Open your camera and point at the code — the right store opens automatically.</p></div>
            </div>
        </div>

        <div class="citizen-phone reveal" data-delay="1">
            <div class="phone">
                <div class="phone-screen citizen-phone-screen phone-screenshot-screen">
                    {% set screenshots = [
                        'fuelpass/images/citizen-app.jpg',
                        'fuelpass/images/citizen-app-2.jpg',
                        'fuelpass/images/citizen-app-3.jpg',
                        'fuelpass/images/citizen-app-4.jpg',
                        'fuelpass/images/citizen-app-5.jpg',
                        'fuelpass/images/citizen-app-6.jpg',
                        'fuelpass/images/citizen-app-7.jpg'
                    ] %}
                    <div class="phone-slider screenshot-slider" data-phone-slider>
                        {% for screenshot in screenshots %}
                            <div class="phone-slide {{ loop.first ? 'is-active' }}">
                                <img class="phone-screenshot" src="{{ asset(screenshot) }}" alt="FuelPass citizen app screenshot {{ loop.index }}">
                            </div>
                        {% endfor %}
                    </div>
                    <div class="phone-dots screenshot-dots" data-phone-dots aria-label="Citizen app screenshots">
                        {% for screenshot in screenshots %}
                            <button class="{{ loop.first ? 'is-active' }}" type="button" aria-label="Show screenshot {{ loop.index }}"></button>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
